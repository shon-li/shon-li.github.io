# frozen_string_literal: true
source "https://rubygems.org"

gem "jekyll", "~> 4.4"

# webrick is no longer a default gem as of Ruby 3.0; needed by `jekyll serve`.
gem "webrick", "~> 1.9"

# Plugins activated via the `plugins` list in _config.yml.
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
end
